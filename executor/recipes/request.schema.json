{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Root prepared recipe request",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "recipes"],
  "properties": {
    "format": {"const": 1},
    "recipes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "version", "revision", "initialSettings", "licenseNotices"],
        "properties": {
          "id": {"enum": ["postgresql16", "clickhouse"]},
          "version": {
            "type": "string",
            "maxLength": 256,
            "pattern": "^(?![lL][aA][tT][eE][sS][tT]$)[A-Za-z0-9.+:~\\-]{1,256}$"
          },
          "revision": {"type": "integer", "minimum": 1, "maximum": 2147483647},
          "initialSettings": {"type": "object"},
          "licenseNotices": {
            "type": "array", "minItems": 1, "maxItems": 16,
            "items": {"type": "string", "minLength": 1, "maxLength": 2000}
          }
        },
        "allOf": [
          {
            "if": {"properties": {"id": {"const": "postgresql16"}}},
            "then": {
              "properties": {
                "version": {"pattern": "^(?:[0-9]+:)?16\\."},
                "initialSettings": {
                  "additionalProperties": false,
                  "required": ["max_connections", "shared_buffers_mb"],
                  "properties": {
                    "max_connections": {"type": "integer", "minimum": 10, "maximum": 1000},
                    "shared_buffers_mb": {"type": "integer", "minimum": 16, "maximum": 16384}
                  }
                }
              }
            }
          },
          {
            "if": {"properties": {"id": {"const": "clickhouse"}}},
            "then": {
              "properties": {
                "initialSettings": {
                  "additionalProperties": false,
                  "required": ["max_connections", "max_server_memory_usage_mb"],
                  "properties": {
                    "max_connections": {"type": "integer", "minimum": 10, "maximum": 10000},
                    "max_server_memory_usage_mb": {"type": "integer", "minimum": 128, "maximum": 1048576}
                  }
                }
              }
            }
          }
        ]
      }
    }
  }
}
